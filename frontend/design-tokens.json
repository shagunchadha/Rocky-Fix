{
  "name": "alien-translator-tokens",
  "version": "1.0.0",
  "colors": {
    "background": "#071027",
    "surface": "#0b1226",
    "glass": "rgba(233,245,255,0.06)",
    "primary": "#00d1c1",
    "accent": "#8a3ffc",
    "highlight": "#ff8a00",
    "muted": "#9aa6b2",
    "text": "#e9f5ff",
    "error": "#ff5c5c",
    "success": "#47d16b"
  },
  "typography": {
    "fontFamily": {
      "display": "Orbitron, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial",
      "body": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial"
    },
    "fontSizes": {
      "xs": "12px",
      "sm": "14px",
      "md": "16px",
      "lg": "20px",
      "xl": "28px",
      "xxl": "36px"
    },
    "lineHeights": {
      "sm": "1.2",
      "md": "1.4",
      "lg": "1.5"
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "bold": 700
    }
  },
  "spacing": {
    "none": "0px",
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "xxl": "48px"
  },
  "radii": {
    "sm": "6px",
    "md": "12px",
    "lg": "20px",
    "round": "9999px"
  },
  "shadows": {
    "low": "0 2px 6px rgba(2,6,23,0.6)",
    "medium": "0 8px 24px rgba(2,6,23,0.65)",
    "glow": "0 0 20px rgba(138,63,252,0.12)"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "base": "240ms",
      "slow": "360ms"
    },
    "easing": {
      "standard": "cubic-bezier(.2,.8,.2,1)",
      "splash": "cubic-bezier(.16,.84,.44,1)"
    },
    "pulse": {
      "scale": 1.02,
      "duration": "800ms"
    }
  },
  "components": {
    "hud": {
      "bg": "rgba(11,18,38,0.6)",
      "border": "rgba(233,245,255,0.08)",
      "backdropFilter": "blur(8px)"
    },
    "transcript": {
      "bg": "rgba(255,255,255,0.02)",
      "finalBorder": "rgba(0,209,193,0.12)",
      "interimOpacity": 0.7
    },
    "characterWidget": {
      "size": "72px",
      "accentGlow": "rgba(0,209,193,0.12)"
    }
  }
}
